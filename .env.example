PORT=3000
# nginx 뒤에서만 접근하도록 로컬 바인딩
HOST=127.0.0.1
MAX_FILE_SIZE_MB=50
MAX_STORAGE_GB=10
UPLOAD_DIR=./uploads
DB_PATH=./career.db

# 로그인 (필수 - 없으면 서버가 기동하지 않음)
AUTH_USER=admin
# node scripts/hash-password.js '<password>' 출력값
AUTH_PASS_HASH=scrypt$<saltHex>$<hashHex>
# 32자 이상 랜덤값: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
